   CriarBotao(PREFIXO + "emerg",       x + 430, rodapeY, 80, h + 4, "EMERG");
   CriarCelula(PREFIXO + "status",     x + 515, rodapeY, 60, h + 4, "ON", InpCorFundo, InpCorVerde);

   //--- Pinta o botão EMERG de vermelho
   ObjectSetInteger(0, PREFIXO + "emerg", OBJPROP_BGCOLOR, clrDarkRed);
   ObjectSetInteger(0, PREFIXO + "emerg", OBJPROP_COLOR, clrWhite);
   
   ChartRedraw();
  }
  
//+------------------------------------------------------------------+
//| Cria uma célula (fundo + texto)                                   |
//+------------------------------------------------------------------+
void CriarCelula(string nome, int x, int y, int w, int h,
                 string texto, color corFundo, color corTexto)
  {
   string nomeFundo = nome + "_bg";
   if(ObjectFind(0, nomeFundo) < 0)
      ObjectCreate(0, nomeFundo, OBJ_RECTANGLE_LABEL, 0, 0, 0);
   ObjectSetInteger(0, nomeFundo, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nomeFundo, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nomeFundo, OBJPROP_XSIZE, w);
   ObjectSetInteger(0, nomeFundo, OBJPROP_YSIZE, h);
   ObjectSetInteger(0, nomeFundo, OBJPROP_BGCOLOR, corFundo);
   ObjectSetInteger(0, nomeFundo, OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(0, nomeFundo, OBJPROP_COLOR, clrDimGray);
   ObjectSetInteger(0, nomeFundo, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetInteger(0, nomeFundo, OBJPROP_BACK, false);
   ObjectSetInteger(0, nomeFundo, OBJPROP_SELECTABLE, false);

   if(ObjectFind(0, nome) < 0)
      ObjectCreate(0, nome, OBJ_LABEL, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x + 4);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y + 3);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
   ObjectSetString(0, nome, OBJPROP_FONT, "Arial");
   ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, corTexto);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
   ObjectSetInteger(0, nome, OBJPROP_BACK, false);
  }

//+------------------------------------------------------------------+
//| Cria um botão                                                     |
//+------------------------------------------------------------------+
void CriarBotao(string nome, int x, int y, int w, int h, string texto)
  {
   if(ObjectFind(0, nome) < 0)
      ObjectCreate(0, nome, OBJ_BUTTON, 0, 0, 0);
   ObjectSetInteger(0, nome, OBJPROP_XDISTANCE, x);
   ObjectSetInteger(0, nome, OBJPROP_YDISTANCE, y);
   ObjectSetInteger(0, nome, OBJPROP_XSIZE, w);
   ObjectSetInteger(0, nome, OBJPROP_YSIZE, h);
   ObjectSetInteger(0, nome, OBJPROP_CORNER, CORNER_LEFT_UPPER);
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
   ObjectSetString(0, nome, OBJPROP_FONT, "Arial");
   ObjectSetInteger(0, nome, OBJPROP_FONTSIZE, 8);
   ObjectSetInteger(0, nome, OBJPROP_COLOR, clrWhite);
   ObjectSetInteger(0, nome, OBJPROP_BGCOLOR, clrDimGray);
   ObjectSetInteger(0, nome, OBJPROP_BORDER_COLOR, clrBlack);
   ObjectSetInteger(0, nome, OBJPROP_STATE, false);
   ObjectSetInteger(0, nome, OBJPROP_SELECTABLE, false);
  }

//+------------------------------------------------------------------+
//| Atualiza o texto de uma célula                                    |
//+------------------------------------------------------------------+
void AtualizarCelula(string nome, string texto, color corTexto = clrNONE)
  {
   if(ObjectFind(0, nome) < 0) return;
   ObjectSetString(0, nome, OBJPROP_TEXT, texto);
   if(corTexto != clrNONE)
      ObjectSetInteger(0, nome, OBJPROP_COLOR, corTexto);
  }

//+------------------------------------------------------------------+
//| Atualiza a cor de fundo de uma célula                             |
//+------------------------------------------------------------------+
void AtualizarCorFundo(string nome, color cor)
  {
   string nomeFundo = nome + "_bg";
   if(ObjectFind(0, nomeFundo) < 0) return;
   ObjectSetInteger(0, nomeFundo, OBJPROP_BGCOLOR, cor);
  }

//+------------------------------------------------------------------+
//| Remove todos os objetos do painel                                 |
//+------------------------------------------------------------------+
void LimparObjetos()
  {
   ObjectsDeleteAll(0, PREFIXO);
   ChartRedraw();
  }

//+------------------------------------------------------------------+
//| Verifica se está dentro do horário permitido                      |
//+------------------------------------------------------------------+
bool DentroDoHorario()
  {
   if(!InpUsarHorario) return true;  // 24h / swing

   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);

   int minutosAgora  = dt.hour * 60 + dt.min;
   int minutosInicio = InpHoraInicio * 60 + InpMinutoInicio;
   int minutosFim    = InpHoraFim * 60 + InpMinutoFim;

   return (minutosAgora >= minutosInicio && minutosAgora <= minutosFim);
  }


//+------------------------------------------------------------------+
//| Detecta mudança de dia (para resetar contadores)                  |
//+------------------------------------------------------------------+
void VerificarNovoDia(int index)
  {
   MqlDateTime dt;
   TimeToStruct(TimeCurrent(), dt);
   dt.hour = 0; dt.min = 0; dt.sec = 0;

   datetime hoje = StructToTime(dt);

   if(ativos[index].diaReferencia != hoje)
     {
      ativos[index].diaReferencia = hoje;
      ativos[index].entradasHoje  = 0;
     }
  }
