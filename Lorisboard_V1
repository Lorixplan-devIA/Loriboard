//+------------------------------------------------------------------+
//| Expert initialization function                                    |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| Valida os inputs antes de iniciar                                  |
//+------------------------------------------------------------------+
bool ValidarInputs()
  {
   bool ok = true;

   if(InpNumeroLinhas < 1 || InpNumeroLinhas > 50)
     {
      Print("❌ ERRO: InpNumeroLinhas deve estar entre 1 e 50.");
      ok = false;
     }

   if(InpPeriodoMM9 <= 0 || InpPeriodoMM32 <= 0 || InpPeriodoMM100 <= 0)
     {
      Print("❌ ERRO: Períodos das médias devem ser > 0.");
      ok = false;
     }

   if(InpPeriodoMM9 >= InpPeriodoMM32)
     {
      Print("⚠️ AVISO: InpPeriodoMM9 >= InpPeriodoMM32. O cruzamento pode não funcionar bem.");
     }

   if(InpPeriodoMM32 >= InpPeriodoMM100)
     {
      Print("⚠️ AVISO: InpPeriodoMM32 >= InpPeriodoMM100. A condição '< MM100' pode nunca ser verdadeira.");
     }

   if(InpSlippage < 0)
     {
      Print("❌ ERRO: InpSlippage deve ser >= 0.");
      ok = false;
     }

   if(InpSegundosCheck < 1)
     {
      Print("❌ ERRO: InpSegundosCheck deve ser >= 1.");
      ok = false;
     }

   if(InpUsarHorario)
     {
      if(InpHoraInicio < 0 || InpHoraInicio > 23 || InpHoraFim < 0 || InpHoraFim > 23)
        {
         Print("❌ ERRO: Horas devem estar entre 0 e 23.");
         ok = false;
        }
     }

   if(InpPercentualLucro <= 0.0 && InpTipoSaida == SAIDA_PERCENTUAL)
     {
      Print("❌ ERRO: InpPercentualLucro deve ser > 0 quando tipo de saída é percentual.");
      ok = false;
     }

   return ok;
  }

//+------------------------------------------------------------------+
//| Log controlado (respeita InpLogDetalhado)                          |
//+------------------------------------------------------------------+
void LogDetalhado(string msg)
  {
   if(InpLogDetalhado)
      Print(msg);
  }

int OnInit()
  {
   //--- Valida inputs primeiro
   if(!ValidarInputs())
     {
      return(INIT_PARAMETERS_INCORRECT);
     }

   long modo = AccountInfoInteger(ACCOUNT_MARGIN_MODE);
   g_modoNetting = (modo == ACCOUNT_MARGIN_MODE_RETAIL_NETTING);

   PrintFormat("EA iniciado. Modo da conta: %s",
               g_modoNetting ? "NETTING" : "HEDGING");

   g_totalLinhas = InpNumeroLinhas;
   ArrayResize(ativos, g_totalLinhas);

   trade.SetExpertMagicNumber(InpMagicBase);
   trade.SetDeviationInPoints(InpSlippage);
   trade.SetTypeFillingBySymbol(_Symbol);

   int carregados = ParsearListaAtivos();
   if(carregados == 0)
     {
      Print("ERRO: Nenhum ativo carregado. Verifique a lista.");
      return(INIT_PARAMETERS_INCORRECT);
     }

   PrintFormat("Total de ativos carregados: %d", carregados);

   //--- Carrega histórico do CSV
   CarregarCSV();
   ReconstruirControle();

   //--- Sincroniza com posições reais do MT5
   for(int i = 0; i < g_totalLinhas; i++)
     {
      if(ativos[i].simbolo == "") continue;
      SincronizarEntradas(i);
      AtualizarPosicaoReal(i);
     }

   CriarPainel();
   EventSetTimer(5);

   g_ultimoCheck = 0;
   g_ultimaSync  = TimeCurrent();

   Print("OnInit concluído com sucesso.");
   return(INIT_SUCCEEDED);
  } 

  
//+------------------------------------------------------------------+
//| Expert deinitialization function                                  |
//+------------------------------------------------------------------+
void OnDeinit(const int reason)
  {
   //--- Salva estado atual antes de sair
   SalvarCSV();

   EventKillTimer();
   LimparObjetos();
   Print("EA finalizado. Motivo: ", reason, " | CSV salvo.");
  }
//+------------------------------------------------------------------+
//| Expert tick function                                              |
//+------------------------------------------------------------------+
void OnTick()
  {
   //--- Controle de performance: só roda a cada N segundos
   datetime agora = TimeCurrent();
   if(agora - g_ultimoCheck < InpSegundosCheck)
      return;

   g_ultimoCheck = agora;

   //--- 1) Verifica saídas primeiro (proteção)
   ExecutarSaidas();

   //--- 2) Depois verifica entradas
   ExecutarAuto();
  }

//+------------------------------------------------------------------+
//| Timer function (5s)                                               |
//+------------------------------------------------------------------+
void OnTimer()
  {
   double total = 0.0;

   for(int i = 0; i < g_totalLinhas; i++)
     {
      if(ativos[i].simbolo == "") continue;

      if(InpModoEA == MODO_SWING)
         VerificarNovoDia(i);

      AtualizarFiltroD1(i);
      AtualizarGatilhoM5(i);
      AtualizarPosicaoReal(i);
      SincronizarEntradas(i);
      AtualizarIndicadoresVisuais(i);

      string nomeContr = PREFIXO + "contr_" + IntegerToString(i);
      string nomeValor = PREFIXO + "valor_" + IntegerToString(i);

      AtualizarCelula(nomeContr, DoubleToString(ativos[i].volumeAtual, 2));

      color corValor = InpCorTexto;
      if(ativos[i].pnlAtual > 0.0)      corValor = InpCorVerde;
      else if(ativos[i].pnlAtual < 0.0) corValor = InpCorVermelho;

      AtualizarCelula(nomeValor, DoubleToString(ativos[i].pnlAtual, 2), corValor);

      total += ativos[i].pnlAtual;
     }

   color corTotal = InpCorTexto;
   if(total > 0.0)      corTotal = InpCorVerde;
   else if(total < 0.0) corTotal = InpCorVermelho;

   AtualizarCelula(PREFIXO + "total_lbl", "TOTAL: " + DoubleToString(total, 2), corTotal);

      //--- Status do EA
   string statusTxt = "ON";
   color  statusCor = InpCorVerde;

   bool foraHorario = (InpUsarHorario && !DentroDoHorario() && InpModoEA == MODO_DAYTRADE);

   if(g_eaPausado && foraHorario)
     {
      statusTxt = "P/FR";
      statusCor = clrOrange;
     }
   else if(g_eaPausado)
     {
      statusTxt = "PAUS";
      statusCor = InpCorVermelho;
     }
   else if(foraHorario)
     {
      statusTxt = "F/HR";
      statusCor = clrOrange;
     }

   AtualizarCelula(PREFIXO + "status", statusTxt, statusCor);

   //--- Salva CSV periodicamente
   SalvarCSV();

   ChartRedraw();
  }
 
 
  
//+------------------------------------------------------------------+
//| ChartEvent function                                               |
//+------------------------------------------------------------------+
void OnChartEvent(const int id,
                  const long &lparam,
                  const double &dparam,
                  const string &sparam)
  {
   if(id != CHARTEVENT_OBJECT_CLICK) return;

   //--- PAUSAR
   if(sparam == PREFIXO + "pausar")
     {
      g_eaPausado = !g_eaPausado;
      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
      PrintFormat("EA %s.", g_eaPausado ? "PAUSADO" : "RETOMADO");
      return;
     }

   //--- FECHAR TUDO
   if(sparam == PREFIXO + "fechar_tudo")
      //--- SALVAR CSV
   if(sparam == PREFIXO + "salvar")
     {
      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
      SalvarCSV();
      Print("💾 CSV salvo manualmente.");
      return;
     }
     
        //--- EMERG: fecha tudo + pausa + salva
   if(sparam == PREFIXO + "emerg")
     {
      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
      Print("🚨 EMERGÊNCIA: fechando tudo e pausando EA...");

      int totalFechadas = 0;
      for(int i = 0; i < g_totalLinhas; i++)
        {
         if(ativos[i].simbolo == "") continue;
         if(FecharTudoDoAtivo(i)) totalFechadas++;
        }

      g_eaPausado = true;
      SalvarCSV();

      PrintFormat("🚨 EMERGÊNCIA concluída. %d ativo(s) fechado(s). EA PAUSADO.",
                  totalFechadas);
      return;
     }
     
     {
      ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
      Print("FECHAR TUDO acionado...");
      int totalFechadas = 0;
      for(int i = 0; i < g_totalLinhas; i++)
        {
         if(ativos[i].simbolo == "") continue;
         if(FecharTudoDoAtivo(i)) totalFechadas++;
        }
      PrintFormat("Total de ativos com posições fechadas: %d", totalFechadas);
      return;
     }

   //--- Botões por linha
   for(int i = 0; i < g_totalLinhas; i++)
     {
      string sfx = "_" + IntegerToString(i);

      if(sparam == PREFIXO + "buy" + sfx)
        {
         ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
         AbrirOrdem(i, ORDER_TYPE_BUY);
         return;
        }
      if(sparam == PREFIXO + "sell" + sfx)
        {
         ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
         AbrirOrdem(i, ORDER_TYPE_SELL);
         return;
        }
      if(sparam == PREFIXO + "f" + sfx)
        {
         ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
         FecharTudoDoAtivo(i);
         return;
        }
      if(sparam == PREFIXO + "f1" + sfx)
        {
         ObjectSetInteger(0, sparam, OBJPROP_STATE, false);
         FecharUltimaEntrada(i);
         return;
        }
     }
  }

//+------------------------------------------------------------------+
//| Lê valor de uma string separada por vírgula na posição index      |
//+------------------------------------------------------------------+
double LerValorLista(string lista, int index, double padrao)
  {
   string partes[];
   int total = StringSplit(lista, ',', partes);
   if(total <= index) return padrao;

   string s = partes[index];
   StringTrimLeft(s);
   StringTrimRight(s);
   if(StringLen(s) == 0) return padrao;

   return StringToDouble(s);
  }


//+------------------------------------------------------------------+
//| Parse da lista de símbolos                                        |
//+------------------------------------------------------------------+
int ParsearListaAtivos()
  {
   string lista = InpListaAtivos;
   StringTrimLeft(lista);
   StringTrimRight(lista);

   if(StringLen(lista) == 0)
     {
      Print("ERRO: Lista de ativos vazia.");
      return 0;
     }

   string partes[];
   int total = StringSplit(lista, ',', partes);

   if(total <= 0)
     {
      Print("ERRO: Falha ao dividir lista de ativos.");
      return 0;
     }

   if(total != g_totalLinhas)
     {
      PrintFormat("AVISO: Input tinha %d linhas, mas a lista tem %d símbolos. Ajustando.",
                  g_totalLinhas, total);
      g_totalLinhas = total;
      ArrayResize(ativos, g_totalLinhas);
     }

   int contador = 0;
   for(int i = 0; i < total; i++)
     {
      string sym = partes[i];
      StringTrimLeft(sym);
      StringTrimRight(sym);
      StringToUpper(sym);

      if(StringLen(sym) == 0) continue;

      if(!SymbolSelect(sym, true))
        {
         PrintFormat("AVISO: Símbolo '%s' não encontrado. Ignorando.", sym);
         continue;
        }

      ativos[contador].simbolo           = sym;
      ativos[contador].magic             = InpMagicBase + contador + 1;
      ativos[contador].loteManual        = LerValorLista(InpListaLotes,    contador, 0.01);
      ativos[contador].maxContratosDia   = LerValorLista(InpListaMaxDia,   contador, 100.0);
      ativos[contador].maxContratosTotal = LerValorLista(InpListaMaxTotal, contador, 100.0);
      ativos[contador].filtroD1OK        = false;
      ativos[contador].gatilhoEntradaOK  = false;
      ativos[contador].gatilhoSaidaOK    = false;
      ativos[contador].volumeAtual       = 0.0;
      ativos[contador].pnlAtual          = 0.0;
      ativos[contador].ultimaEntrada     = 0;
      ativos[contador].entradasHoje      = 0;
      ativos[contador].diaReferencia     = 0;
      ArrayResize(ativos[contador].entradas, 0);

      if(!CriarHandles(contador))
        {
         PrintFormat("AVISO: Falha nos handles de %s. Linha será ignorada.", sym);
         ativos[contador].simbolo = "";
         continue;
        }

      PrintFormat("Ativo [%d] %s carregado (magic %d, lote %s, maxDia %s, maxTotal %s).",
                  contador, sym, ativos[contador].magic,
                  DoubleToString(ativos[contador].loteManual, 2),
                  DoubleToString(ativos[contador].maxContratosDia, 2),
                  DoubleToString(ativos[contador].maxContratosTotal, 2));
      contador++;
     }

   return contador;
  }

//+------------------------------------------------------------------+
//| Lê o valor de um buffer de indicador na barra especificada         |
//+------------------------------------------------------------------+
double LerBuffer(int handle, int buffer, int shift)
  {
   if(handle == INVALID_HANDLE) return 0.0;

   double buf[];
   if(CopyBuffer(handle, buffer, shift, 1, buf) <= 0) return 0.0;

   return buf[0];
  }

//+------------------------------------------------------------------+
//| Atualiza o filtro D1 de um ativo                                   |
//| Condição: Preço D1 > MM9 D1                                        |
//+------------------------------------------------------------------+
void AtualizarFiltroD1(int index)
  {
   if(ativos[index].simbolo == "") return;

   double mm9 = LerBuffer(ativos[index].hMM9_D1, 0, 0);
   double precoD1 = iClose(ativos[index].simbolo, PERIOD_D1, 0);

   if(mm9 == 0.0 || precoD1 == 0.0)
     {
      ativos[index].filtroD1OK = false;
      return;
     }

   ativos[index].filtroD1OK = (precoD1 > mm9);
  }

//+------------------------------------------------------------------+
//| Atualiza o gatilho M5 de um ativo                                  |
//| Condição: MM9 < MM100 E MM32 < MM100 E MM9 cruzou MM32 para cima  |
//+------------------------------------------------------------------+
void AtualizarGatilhoM5(int index)
  {
   if(ativos[index].simbolo == "") return;

   double mm9_0   = LerBuffer(ativos[index].hMM9_M5,   0, 0);
   double mm9_1   = LerBuffer(ativos[index].hMM9_M5,   0, 1);
   double mm32_0  = LerBuffer(ativos[index].hMM32_M5,  0, 0);
   double mm32_1  = LerBuffer(ativos[index].hMM32_M5,  0, 1);
   double mm100_0 = LerBuffer(ativos[index].hMM100_M5, 0, 0);

   if(mm9_0 == 0.0 || mm32_0 == 0.0 || mm100_0 == 0.0)
     {
      ativos[index].gatilhoEntradaOK = false;
      return;
     }

   bool ambosAbaixo = (mm9_0 < mm100_0) && (mm32_0 < mm100_0);
   bool cruzouAcima = (mm9_1 <= mm32_1) && (mm9_0 > mm32_0);

   ativos[index].gatilhoEntradaOK = (ambosAbaixo && cruzouAcima);
  }

//+------------------------------------------------------------------+
//| Atualiza os indicadores visuais (D1 e GAT) de uma linha            |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| Abre uma ordem no ativo (compra ou venda)                          |
//+------------------------------------------------------------------+
bool AbrirOrdem(int index, ENUM_ORDER_TYPE tipo)
  {
   if(index < 0 || index >= g_totalLinhas) return false;

   string sym  = ativos[index].simbolo;
   double lote = ativos[index].loteManual;

   if(sym == "" || lote <= 0.0)
     {
      PrintFormat("ERRO: Ativo %d inválido para abrir ordem.", index);
      return false;
     }

   //--- Normaliza volume ao step do símbolo
   symInfo.Name(sym);
   symInfo.RefreshRates();
   double step = symInfo.LotsStep();
   double minLot = symInfo.LotsMin();
   double maxLot = symInfo.LotsMax();

   lote = MathFloor(lote / step) * step;
   if(lote < minLot) lote = minLot;
   if(lote > maxLot) lote = maxLot;

   //--- Define magic desta linha
   trade.SetExpertMagicNumber(ativos[index].magic);

   //--- Envia ordem
   bool ok = false;
   if(tipo == ORDER_TYPE_BUY)
      ok = trade.Buy(lote, sym, 0.0, 0.0, 0.0, "LoriBoard Buy");
   else
      ok = trade.Sell(lote, sym, 0.0, 0.0, 0.0, "LoriBoard Sell");

   if(!ok)
     {
      PrintFormat("ERRO ao abrir %s em %s: %d - %s",
                  tipo == ORDER_TYPE_BUY ? "BUY" : "SELL",
                  sym, trade.ResultRetcode(), trade.ResultRetcodeDescription());
      return false;
     }

   //--- Registra entrada no array
   ulong ticket = trade.ResultOrder();
   ulong dealTicket = trade.ResultDeal();

   //--- Espera a posição aparecer
   Sleep(100);

   //--- Encontra o ticket da posição
   ulong posTicket = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      if(posInfo.SelectByIndex(i))
        {
         if(posInfo.Symbol() == sym && posInfo.Magic() == ativos[index].magic)
           {
            posTicket = posInfo.Ticket();
            break;
           }
        }
     }

   if(posTicket == 0)
     {
      PrintFormat("AVISO: Ordem enviada mas posição não encontrada para %s.", sym);
      return true; // a ordem foi aceita, apenas não localizamos a posição
     }

   //--- Adiciona ao array de entradas
   int n = ArraySize(ativos[index].entradas);
   ArrayResize(ativos[index].entradas, n + 1);
   ativos[index].entradas[n].ticket        = posTicket;
   ativos[index].entradas[n].volume        = lote;
   ativos[index].entradas[n].dataAbertura  = TimeCurrent();
   ativos[index].entradas[n].precoEntrada  = posInfo.PriceOpen();
   ativos[index].entradas[n].ativa         = true;

   //--- Atualiza contadores
   ativos[index].ultimaEntrada = TimeCurrent();
   ativos[index].entradasHoje++;

   PrintFormat("✅ %s aberto em %s | lote %.2f | ticket %I64u | magic %d",
               tipo == ORDER_TYPE_BUY ? "BUY" : "SELL",
               sym, lote, posTicket, ativos[index].magic);

 //--- Persiste no CSV
   SalvarCSV();

   return true;
  }

//+------------------------------------------------------------------+
//| Fecha TODAS as entradas de um ativo                                |
//+------------------------------------------------------------------+
bool FecharTudoDoAtivo(int index)
  {
   if(index < 0 || index >= g_totalLinhas) return false;

   string sym = ativos[index].simbolo;
   if(sym == "") return false;

   trade.SetExpertMagicNumber(ativos[index].magic);

   int fechadas = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      if(posInfo.SelectByIndex(i))
        {
         if(posInfo.Symbol() == sym && posInfo.Magic() == ativos[index].magic)
           {
            if(trade.PositionClose(posInfo.Ticket()))
              {
               fechadas++;
              }
            else
              {
               PrintFormat("ERRO ao fechar ticket %I64u: %d - %s",
                           posInfo.Ticket(), trade.ResultRetcode(),
                           trade.ResultRetcodeDescription());
              }
           }
        }
     }

   if(fechadas > 0)
     {
      PrintFormat("✅ %d posição(ões) fechada(s) em %s", fechadas, sym);
      //--- Marca entradas como inativas
      for(int j = 0; j < ArraySize(ativos[index].entradas); j++)
         ativos[index].entradas[j].ativa = false;
     }

   //--- Persiste no CSV
   SalvarCSV();
   
   return (fechadas > 0);
  }

//+------------------------------------------------------------------+
//| Fecha SOMENTE a última entrada de um ativo                        |
//+------------------------------------------------------------------+
bool FecharUltimaEntrada(int index)
  {
   if(index < 0 || index >= g_totalLinhas) return false;

   string sym = ativos[index].simbolo;
   if(sym == "") return false;

   trade.SetExpertMagicNumber(ativos[index].magic);

   //--- Percorre de trás para frente (última primeiro)
   ulong ultimoTicket = 0;
   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      if(posInfo.SelectByIndex(i))
        {
         if(posInfo.Symbol() == sym && posInfo.Magic() == ativos[index].magic)
           {
            ultimoTicket = posInfo.Ticket();
            break;
           }
        }
     }

   if(ultimoTicket == 0)
     {
      PrintFormat("AVISO: Nenhuma posição aberta em %s", sym);
      return false;
     }

   if(trade.PositionClose(ultimoTicket))
     {
      //--- Marca a última entrada ativa como inativa
      for(int j = ArraySize(ativos[index].entradas) - 1; j >= 0; j--)
        {
         if(ativos[index].entradas[j].ativa)
           {
            ativos[index].entradas[j].ativa = false;
            break;
           }
        }
      PrintFormat("✅ Última entrada fechada em %s (ticket %I64u)", sym, ultimoTicket);
      return true;
     }
      //--- Persiste no CSV
      SalvarCSV();
      
   PrintFormat("ERRO ao fechar última entrada de %s: %d - %s",
               sym, trade.ResultRetcode(), trade.ResultRetcodeDescription());
   return false;
  }

//+------------------------------------------------------------------+
//| Atualiza volume e P&L de um ativo consultando posições reais       |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| Verifica se pode abrir uma nova entrada em um ativo               |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| Verifica se o ativo atingiu alguma condição de saída              |
//+------------------------------------------------------------------+
bool DeveFechar(int index)
  {
   if(index < 0 || index >= g_totalLinhas) return false;
   if(ativos[index].simbolo == "")          return false;
   if(ativos[index].volumeAtual <= 0.0)     return false;

   string sym = ativos[index].simbolo;

   //--- SAÍDA NUNCA
   if(InpTipoSaida == SAIDA_NUNCA) return false;

   //--- SAÍDA POR HORÁRIO
   if(InpTipoSaida == SAIDA_HORARIO)
     {
      MqlDateTime dt;
      TimeToStruct(TimeCurrent(), dt);
      int minutosAgora = dt.hour * 60 + dt.min;
      int minutosFim   = InpHoraFim * 60 + InpMinutoFim;
      return (minutosAgora >= minutosFim);
     }

   //--- SAÍDA POR CRUZAMENTO INVERSO (MM9 cruza MM32 para baixo)
   if(InpTipoSaida == SAIDA_CRUZ_INVERSO)
     {
      double mm9_0  = LerBuffer(ativos[index].hMM9_M5,  0, 0);
      double mm9_1  = LerBuffer(ativos[index].hMM9_M5,  0, 1);
      double mm32_0 = LerBuffer(ativos[index].hMM32_M5, 0, 0);
      double mm32_1 = LerBuffer(ativos[index].hMM32_M5, 0, 1);

      bool cruzouAbaixo = (mm9_1 >= mm32_1) && (mm9_0 < mm32_0);
      return cruzouAbaixo;
     }

   //--- SAÍDA POR MÁXIMA DAS N BARRAS
   if(InpTipoSaida == SAIDA_MAX_N_BARRAS)
     {
      double close0 = iClose(sym, InpTF_Saida, 0);
      if(close0 == 0.0) return false;

      //--- Pega a maior máxima das últimas N barras (ignora a barra atual)
      double highs[];
      if(CopyHigh(sym, InpTF_Saida, 1, InpNumBarrasSaida, highs) <= 0)
         return false;

      int maiorIdx = ArrayMaximum(highs);
      double maiorHigh = highs[maiorIdx];

      return (close0 > maiorHigh);
     }

   //--- SAÍDA POR PERCENTUAL DE LUCRO
   if(InpTipoSaida == SAIDA_PERCENTUAL)
     {
      //--- Calcula % de lucro sobre o preço médio da posição
      double precoMedio = 0.0;
      double volumeTotal = 0.0;
      double lucroTotal  = 0.0;

      for(int i = PositionsTotal() - 1; i >= 0; i--)
        {
         if(posInfo.SelectByIndex(i))
           {
            if(posInfo.Symbol() == sym && posInfo.Magic() == ativos[index].magic)
              {
               precoMedio  += posInfo.PriceOpen() * posInfo.Volume();
               volumeTotal += posInfo.Volume();
               lucroTotal  += posInfo.Profit() + posInfo.Swap();
              }
           }
        }

      if(volumeTotal == 0.0) return false;
      precoMedio /= volumeTotal;

      //--- Calcula variação percentual do preço
      double precoAtual = SymbolInfoDouble(sym, SYMBOL_BID);
      if(precoAtual == 0.0 || precoMedio == 0.0) return false;

      double variacaoPct = ((precoAtual - precoMedio) / precoMedio) * 100.0;

      //--- Considera posição comprada (buy)
      if(posInfo.PositionType() == POSITION_TYPE_BUY)
         return (variacaoPct >= InpPercentualLucro);
      else
         return (variacaoPct <= -InpPercentualLucro);
     }

   return false;
  }

//+------------------------------------------------------------------+
//| Loop de verificação de saída automática                           |
//+------------------------------------------------------------------+
void ExecutarSaidas()
  {
   //--- Verifica se passou do horário de fechamento (daytrade)
   bool passouHorario = false;
   if(InpModoEA == MODO_DAYTRADE && InpUsarHorario)
     {
      MqlDateTime dt;
      TimeToStruct(TimeCurrent(), dt);
      int minutosAgora = dt.hour * 60 + dt.min;
      int minutosFim   = InpHoraFim * 60 + InpMinutoFim;
      passouHorario = (minutosAgora >= minutosFim);
     }

   for(int i = 0; i < g_totalLinhas; i++)
     {
      if(ativos[i].simbolo == "") continue;
      if(ativos[i].volumeAtual <= 0.0) continue;

      //--- 1) Saída por horário (proteção daytrade)
      if(passouHorario)
        {
         LogDetalhado("⏰ Fechando " + ativos[i].simbolo + " por horário (daytrade).");
         FecharTudoDoAtivo(i);
         continue;
        }

      //--- 2) Saída configurada
      if(DeveFechar(i))
        {
         PrintFormat("🚪 Saída acionada em %s (magic %d) — fechando tudo",
                     ativos[i].simbolo, ativos[i].magic);
         FecharTudoDoAtivo(i);
        }
     }
  }

bool PodeAbrirEntrada(int index)
  {
   if(index < 0 || index >= g_totalLinhas) return false;
   if(ativos[index].simbolo == "")          return false;
   if(g_eaPausado)                          return false;
   if(!DentroDoHorario())                   return false;
   if(!ativos[index].filtroD1OK)            return false;
   if(!ativos[index].gatilhoEntradaOK)      return false;

   double volumeAtual = ativos[index].volumeAtual;
   double lote        = ativos[index].loteManual;

   //--- MODO DAYTRADE: 1 posição por ativo, sem reentrada
   if(InpModoEA == MODO_DAYTRADE)
     {
      if(volumeAtual > 0.0) return false;
     }

   //--- MODO SWING: 1 entrada por dia (permite acumular posições antigas)
   if(InpModoEA == MODO_SWING)
     {
      if(ativos[index].entradasHoje > 0)
        {
         return false;
        }
     }

   //--- Verifica limites de contratos
   if(volumeAtual + lote > ativos[index].maxContratosDia)   return false;
   if(volumeAtual + lote > ativos[index].maxContratosTotal) return false;

   return true;
  }
 

//+------------------------------------------------------------------+
//| Loop de execução automática (chamado no OnTick)                    |
//+------------------------------------------------------------------+
void ExecutarAuto()
  {
   if(g_eaPausado) return;

   for(int i = 0; i < g_totalLinhas; i++)
     {
      if(ativos[i].simbolo == "") continue;

      //--- Atualiza posição real antes de decidir
      AtualizarPosicaoReal(i);

      if(PodeAbrirEntrada(i))
        {
         PrintFormat("🎯 Sinal automático em %s (magic %d) — abrindo BUY",
                     ativos[i].simbolo, ativos[i].magic);
         AbrirOrdem(i, ORDER_TYPE_BUY);
        }
     }
  }
//+------------------------------------------------------------------+
//| Sincroniza o array de entradas com as posições reais do MT5       |
//| (remove entradas que foram fechadas manualmente)                   |
//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| Caminho do arquivo de histórico                                   |
//+------------------------------------------------------------------+
string CaminhoCSV()
  {
   return "LoriBoard_historico.csv";
  }

//+------------------------------------------------------------------+
//| Salva todo o histórico no CSV                                     |
//+------------------------------------------------------------------+
void SalvarCSV()
  {
   int handle = FileOpen(CaminhoCSV(), FILE_WRITE | FILE_CSV | FILE_ANSI, ';');
   if(handle == INVALID_HANDLE)
     {
      PrintFormat("ERRO ao abrir CSV para escrita: %d", GetLastError());
      return;
     }

   //--- Cabeçalho
   FileWrite(handle, "simbolo", "magic", "ticket", "volume",
             "dataAbertura", "precoEntrada", "ativa");

   //--- Linhas
   for(int i = 0; i < g_totalLinhas; i++)
     {
      if(ativos[i].simbolo == "") continue;

      int n = ArraySize(ativos[i].entradas);
      for(int j = 0; j < n; j++)
        {
         FileWrite(handle,
                   ativos[i].simbolo,
                   IntegerToString(ativos[i].magic),
                   IntegerToString(ativos[i].entradas[j].ticket),
                   DoubleToString(ativos[i].entradas[j].volume, 2),
                   TimeToString(ativos[i].entradas[j].dataAbertura, TIME_DATE | TIME_SECONDS),
                   DoubleToString(ativos[i].entradas[j].precoEntrada, _Digits),
                   ativos[i].entradas[j].ativa ? "true" : "false");
        }
     }

   FileClose(handle);
  }

//+------------------------------------------------------------------+
//| Carrega o histórico do CSV                                        |
//+------------------------------------------------------------------+
void CarregarCSV()
  {
   string caminho = CaminhoCSV();
   if(!FileIsExist(caminho)) 
     {
      Print("CSV de histórico ainda não existe. Começando do zero.");
      return;
     }

   int handle = FileOpen(caminho, FILE_READ | FILE_CSV | FILE_ANSI, ';');
   if(handle == INVALID_HANDLE)
     {
      PrintFormat("ERRO ao abrir CSV para leitura: %d", GetLastError());
      return;
     }

   int linha = 0;
   int carregadas = 0;

   while(!FileIsEnding(handle))
     {
      string simbolo    = FileReadString(handle);
      string magicStr   = FileReadString(handle);
      string ticketStr  = FileReadString(handle);
      string volumeStr  = FileReadString(handle);
      string dataStr    = FileReadString(handle);
      string precoStr   = FileReadString(handle);
      string ativaStr   = FileReadString(handle);

      linha++;

      //--- Pula cabeçalho
      if(linha == 1) continue;

      //--- Pula linha vazia
      if(StringLen(simbolo) == 0) continue;

      //--- Encontra o índice do ativo na lista atual
      int idx = -1;
      for(int i = 0; i < g_totalLinhas; i++)
        {
         if(ativos[i].simbolo == simbolo)
           {
            idx = i;
            break;
           }
        }

      if(idx < 0) continue; // símbolo não está mais na lista

      //--- Monta EntradaInfo
      EntradaInfo ei;
      ei.ticket        = (ulong)StringToInteger(ticketStr);
      ei.volume        = StringToDouble(volumeStr);
      ei.dataAbertura  = StringToTime(dataStr);
      ei.precoEntrada  = StringToDouble(precoStr);
      ei.ativa         = (ativaStr == "true");

      //--- Adiciona ao array
      int n = ArraySize(ativos[idx].entradas);
      ArrayResize(ativos[idx].entradas, n + 1);
      ativos[idx].entradas[n] = ei;

      carregadas++;
     }

   FileClose(handle);
   PrintFormat("CSV carregado: %d entradas restauradas.", carregadas);
  }

//+------------------------------------------------------------------+
//| Reconstrói dados de controle a partir do histórico carregado      |
//+------------------------------------------------------------------+
void ReconstruirControle()
  {
   for(int i = 0; i < g_totalLinhas; i++)
     {
      if(ativos[i].simbolo == "") continue;

      int n = ArraySize(ativos[i].entradas);
      if(n == 0) continue;

      //--- Descobre a última entrada
      datetime ultima = 0;
      for(int j = 0; j < n; j++)
        {
         if(ativos[i].entradas[j].dataAbertura > ultima)
            ultima = ativos[i].entradas[j].dataAbertura;
        }
      ativos[i].ultimaEntrada = ultima;

      //--- Conta entradas de HOJE
      MqlDateTime dt;
      TimeToStruct(TimeCurrent(), dt);
      dt.hour = 0; dt.min = 0; dt.sec = 0;
      datetime hoje = StructToTime(dt);

      int entradasHoje = 0;
      for(int j = 0; j < n; j++)
        {
         if(ativos[i].entradas[j].dataAbertura >= hoje)
            entradasHoje++;
        }
      ativos[i].entradasHoje  = entradasHoje;
      ativos[i].diaReferencia = hoje;
     }
  }

void SincronizarEntradas(int index)
  {
   if(index < 0 || index >= g_totalLinhas) return;

   string sym = ativos[index].simbolo;
   if(sym == "") return;

   int n = ArraySize(ativos[index].entradas);
   if(n == 0) return;

   for(int j = 0; j < n; j++)
     {
      if(!ativos[index].entradas[j].ativa) continue;

      ulong tk = ativos[index].entradas[j].ticket;
      bool  existe = false;

      for(int i = PositionsTotal() - 1; i >= 0; i--)
        {
         if(posInfo.SelectByIndex(i))
           {
            if(posInfo.Ticket() == tk)
              {
               existe = true;
               break;
              }
           }
        }

      if(!existe)
        {
         ativos[index].entradas[j].ativa = false;
         PrintFormat("🔄 Entrada ticket %I64u de %s foi fechada (sincronização).",
                     tk, sym);
        }
     }
  }

void AtualizarPosicaoReal(int index)
  {
   if(index < 0 || index >= g_totalLinhas) return;

   string sym = ativos[index].simbolo;
   if(sym == "") return;

   double volumeTotal = 0.0;
   double pnlTotal    = 0.0;

   for(int i = PositionsTotal() - 1; i >= 0; i--)
     {
      if(posInfo.SelectByIndex(i))
        {
         if(posInfo.Symbol() == sym && posInfo.Magic() == ativos[index].magic)
           {
            volumeTotal += posInfo.Volume();
            pnlTotal    += posInfo.Profit() + posInfo.Swap();
           }
        }
     }

   ativos[index].volumeAtual = volumeTotal;
   ativos[index].pnlAtual    = pnlTotal;
  }

void AtualizarIndicadoresVisuais(int index)
  {
   string nomeD1  = PREFIXO + "d1_"  + IntegerToString(index);
   string nomeGat = PREFIXO + "gat_" + IntegerToString(index);

   //--- Célula D1
   color corD1 = ativos[index].filtroD1OK ? InpCorVerde : InpCorVermelho;
   AtualizarCorFundo(nomeD1, corD1);
   AtualizarCelula(nomeD1, ativos[index].filtroD1OK ? "OK" : "X", InpCorTexto);

   //--- Célula GAT
   if(ativos[index].gatilhoEntradaOK)
     {
      AtualizarCorFundo(nomeGat, InpCorVerde);
      AtualizarCelula(nomeGat, "SIM", InpCorTexto);
     }
   else
     {
      AtualizarCorFundo(nomeGat, InpCorNeutro);
      AtualizarCelula(nomeGat, "-", InpCorTexto);
     }
  }

//+------------------------------------------------------------------+
//| Cria handles de indicadores para um ativo                         |
//+------------------------------------------------------------------+
bool CriarHandles(int index)
  {
   if(index < 0 || index >= g_totalLinhas) return false;

   string sym = ativos[index].simbolo;
   if(sym == "") return false;

   if(!SymbolSelect(sym, true))
     {
      PrintFormat("ERRO: Símbolo %s não encontrado.", sym);
      return false;
     }

   ativos[index].hMM9_M5    = iMA(sym, PERIOD_M5, InpPeriodoMM9,   0, MODE_EMA, PRICE_CLOSE);
   ativos[index].hMM32_M5   = iMA(sym, PERIOD_M5, InpPeriodoMM32,  0, MODE_EMA, PRICE_CLOSE);
   ativos[index].hMM100_M5  = iMA(sym, PERIOD_M5, InpPeriodoMM100, 0, MODE_EMA, PRICE_CLOSE);
   ativos[index].hMM9_D1    = iMA(sym, PERIOD_D1, InpPeriodoMM9_D1, 0, MODE_EMA, PRICE_CLOSE);
   ativos[index].hMM5_Saida = iMA(sym, InpTF_Saida, InpPeriodoMM5, 0, MODE_EMA, PRICE_HIGH);

   if(ativos[index].hMM9_M5    == INVALID_HANDLE ||
      ativos[index].hMM32_M5   == INVALID_HANDLE ||
      ativos[index].hMM100_M5  == INVALID_HANDLE ||
      ativos[index].hMM9_D1    == INVALID_HANDLE ||
      ativos[index].hMM5_Saida == INVALID_HANDLE)
     {
      PrintFormat("ERRO: Falha ao criar handles para %s.", sym);
      return false;
     }

   return true;
  }

