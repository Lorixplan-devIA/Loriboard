   CriarCelula(PREFIXO + "hdr_ticker", x,       y, 80, h, "TICKER",  InpCorFundo, InpCorTexto);
   CriarCelula(PREFIXO + "hdr_d1",     x + 80,  y, 40, h, "D1",      InpCorFundo, InpCorTexto);
   CriarCelula(PREFIXO + "hdr_gat",    x + 120, y, 50, h, "GAT",     InpCorFundo, InpCorTexto);
   CriarCelula(PREFIXO + "hdr_contr",  x + 170, y, 60, h, "CONTR",   InpCorFundo, InpCorTexto);
   CriarCelula(PREFIXO + "hdr_valor",  x + 230, y, 90, h, "VALOR $", InpCorFundo, InpCorTexto);
