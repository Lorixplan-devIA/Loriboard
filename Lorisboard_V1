//--- Enumerações
enum ENUM_MODO_EA
  {
   MODO_DAYTRADE = 0,   // Daytrade (1 posição por ativo)
   MODO_SWING    = 1    // Swing (reentradas, 1 por dia)
  };

enum ENUM_TIPO_SAIDA
  {
   SAIDA_MAX_N_BARRAS = 0,  // Close[0] > High das últimas N barras
   SAIDA_HORARIO      = 1,  // Fecha no horário configurado
   SAIDA_CRUZ_INVERSO = 2,  // MM9 cruza MM32 para baixo
   SAIDA_PERCENTUAL   = 3,  // X% de lucro
   SAIDA_NUNCA        = 4   // Buy & Hold (não fecha)
  };

//--- Estrutura de cada entrada individual
struct EntradaInfo
  {
   ulong    ticket;
   double   volume;
   datetime dataAbertura;
   double   precoEntrada;
   bool     ativa;
  };

//--- Estrutura de cada ativo/linha do painel
struct AtivoConfig
  {
   string       simbolo;
   int          magic;
   double       loteManual;
   double       maxContratosDia;
   double       maxContratosTotal;

   int          hMM9_M5;
   int          hMM32_M5;
   int          hMM100_M5;
   int          hMM9_D1;
   int          hMM5_Saida;

   bool         filtroD1OK;
   bool         gatilhoEntradaOK;
   bool         gatilhoSaidaOK;

   double       volumeAtual;
   double       pnlAtual;
   datetime     ultimaEntrada;
   int          entradasHoje;
   datetime     diaReferencia;

   EntradaInfo  entradas[];
  };

